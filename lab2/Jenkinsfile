pipeline {
    agent any

    options {
        timestamps()
    }

    stages {
        stage('Check SCM') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                bat '''
                    cd lab2
                    python -m pip install flask unittest-xml-reporting
                    python test_app.py
                '''
            }
            post {
                always {
                    junit 'lab2/test-reports/*.xml'
                }
                success {
                    echo 'Application testing successfully completed!'
                }
                failure {
                    echo 'Oooppss!!! Tests failed!'
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                bat '''
                    cd lab2
                    docker login -u kalashnykv -p dckr_pat_NrGFh_7iJYpTOOGeb8z_gzpd0Ms
                    docker build -t kalashnykv/cinema-manager:latest -f Dockerfile .
                    docker push kalashnykv/cinema-manager:latest
                '''
            }
        }
    }
}