pipeline {
    agent any

    options {
        timestamps()
    }

    stages {
        stage('Check SCM') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                bat '''
                    cd lab2
                    python -m pip install flask unittest-xml-reporting
                    python test_app.py
                '''
            }
            post {
                always {
                    junit 'lab2/test-reports/*.xml'
                }
                success {
                    echo 'Application testing successfully completed!'
                }
                failure {
                    echo 'Oooppss!!! Tests failed!'
                }
            }
        }

        stage('Docker Build & Push') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'docker-hub-credentials', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                    bat '''
                        cd lab2
                        docker login -u %DOCKER_USER% -p %DOCKER_PASS%
                        docker build -t %DOCKER_USER%/cinema-manager:latest -f Dockerfile .
                        docker push %DOCKER_USER%/cinema-manager:latest
                    '''
                }
            }
        }
    }
}